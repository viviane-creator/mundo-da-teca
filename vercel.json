{
  "rewrites": [
    {
      "source": "/((?!assets/|images/|covers/|logo/|cards/|fonts/|favicon\\.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
